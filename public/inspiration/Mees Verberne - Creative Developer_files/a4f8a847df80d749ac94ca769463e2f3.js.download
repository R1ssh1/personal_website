var loadCanvasFrame=!1;var loadCanvas=!1;$(document).ready(function(){setTimeout(function(){if(!loadCanvas){loadCanvas=!0;initLoadObject()}},2900);pageContainerWrap.hooks.on('animation:out:start',()=>{if(!loadCanvas){loadCanvas=!0;initLoadObject();$(document).trigger("animateLoaderInFix")}})});function initLoadObject(){var canvas=document.getElementById('loadCanvas');var renderer=new THREE.WebGLRenderer({alpha:!0,canvas:canvas,precision:"mediump"});renderer.setSize(window.innerWidth,window.innerHeight);var scene=new THREE.Scene();var camera=new THREE.PerspectiveCamera(75,1,0.1,1000);camera.position.z=1;var uniforms={time:{type:'f',value:0.0},resolution:{type:'v2',value:new THREE.Vector2(canvas.width,canvas.height)},scaleX:{type:'f',value:20.0},scaleY:{type:'f',value:40.0},color:{type:'v3',value:new THREE.Vector3(0.38,0.39,0.52)},};var vertexShader=`
        void main() {
            gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);
        }
    `;const fragmentShader=`
precision mediump float;  // Verhoog de precisie naar 'mediump'
uniform float time;
uniform vec2 resolution;
uniform float scaleX;
uniform float scaleY;
        
uniform vec3 color;

float grid(vec2 st, vec2 scale) {
    // Pas st aan zodat het nauwkeurig op het grid past, en beperk de lijnen zonder 'lineThickness'
    vec2 gridPos = abs(fract(st * scale - 0.5) - 0.5);  // Scherpere afronding om gaten te vermijden
    float lineThickness = 0.0;  // Blijf bij een lineThickness van 0
    vec2 grid = step(vec2(lineThickness), gridPos); 
    return grid.x * grid.y;
}

float random(vec2 st) {
    return fract(sin(dot(st.xy, vec2(12.9898, 78.233))) * 43758.5453123);  // Randomizer voor fade delay
}

void main() {
    vec2 st = gl_FragCoord.xy / resolution.xy;
    vec2 scale = vec2(scaleX, scaleY);
    
    // Bereken grid zonder zichtbare tussenruimtes
    float g = grid(st, scale);

    vec2 gridCoord = floor(st * scale);
    float offset = random(gridCoord);  // Willekeurige offset voor fade-in per blokje

    // Bereken de fade op basis van tijd en grid positie
    float fadeTime = time * 0.2;  // Langzamere tijdsverandering voor fade
    float fadeDelay = offset * 2.0;  // Random vertraging per blokje op basis van hun offset

    // Bereken een soepele fade-in: alpha moet geleidelijk van 0 (onzichtbaar) naar 1 (volledig zichtbaar) gaan
    float fade = smoothstep(0.0, 1.0, fadeTime - fadeDelay);

    // Stel hier de kleur in die je voor de blokjes wilt gebruiken
    vec3 color = color;  // Dit is de kleur voor de blokjes

    // Alpha bepaalt de zichtbaarheid van de blokjes: dit zorgt voor alleen een fade op de opacity, niet de kleur
    float alpha = fade * g;

    // Gooi fragmenten weg als ze volledig transparant zijn
    if (alpha <= 0.4) {
        discard;  // Gooi het fragment weg als de alpha te laag is (volledige transparantie)
    }

    // Stel de uiteindelijke kleur en transparantie in (kleur is altijd de gedefinieerde kleur, alleen de alpha verandert)
    gl_FragColor = vec4(color, alpha);
}




`;var material=new THREE.ShaderMaterial({uniforms:uniforms,vertexShader:vertexShader,fragmentShader:fragmentShader});var planeGeometry=new THREE.PlaneGeometry(10,10,100,100);var plane=new THREE.Mesh(planeGeometry,material);scene.add(plane);function animate(){if(loadCanvasFrame){requestAnimationFrame(animate);renderer.render(scene,camera)}}
function calculateScaleX(){if($(window).width()<=580){var baseGridCountX=15}else{var baseGridCountX=45}
return canvas.width/baseGridCountX}
function calculateScaleY(){if($(window).width()<=580){var fixedRowCount=40}else{var fixedRowCount=20}
return fixedRowCount}
function resizeCanvas(){canvas.width=window.innerWidth;canvas.height=window.innerHeight;renderer.setSize(canvas.width,canvas.height);uniforms.resolution.value.set(canvas.width,canvas.height);camera.aspect=canvas.width/canvas.height;camera.updateProjectionMatrix();uniforms.scaleX.value=calculateScaleX();uniforms.scaleY.value=calculateScaleY()}
resizeCanvas();window.addEventListener('resize',resizeCanvas,!1);pageContainerWrap.hooks.on('animation:out:start',()=>{loadCanvasFrame=!0;animate();gsap.to(".loadCanvasWrapper",.45,{opacity:1,overwrite:!0,ease:"power1.out"});$("html, body").addClass("overflow");scroller.stop();gsap.to(uniforms.time,.45,{value:15.0,overwrite:!0,ease:"power1.out"});$(".loadCanvasWrapper").addClass("loaded")});$(document).on("animateLoaderInFix",function(){loadCanvasFrame=!0;animate();gsap.to(".loadCanvasWrapper",.45,{opacity:1,overwrite:!0,ease:"power1.out"});$("html, body").addClass("overflow");scroller.stop();gsap.to(uniforms.time,.45,{value:15.0,overwrite:!0,ease:"power1.out"});$(".loadCanvasWrapper").addClass("loaded")});$(document).on("animateLoaderIn",function(){loadCanvasFrame=!0;animate();gsap.to(uniforms.color,0,{type:'v3',value:new THREE.Vector3(0.133,0.149,0.294)});$(".loadCanvasWrapper").addClass("loaded");gsap.to(".loadCanvasWrapper",.45,{opacity:1,overwrite:!0,ease:"power1.out"});gsap.to(uniforms.time,.45,{value:15.0,overwrite:!0,ease:"power1.out"})});$(document).on("animateLoaderOut",function(){animate();$(".loadCanvasWrapper").removeClass("loaded");gsap.to(".loadCanvasWrapper",.9,{opacity:0,delay:.15,ease:"power1.out"});gsap.to(uniforms.time,.9,{value:0.0,ease:"power1.out",delay:.15,onComplete:function(){loadCanvasFrame=!1;gsap.to(uniforms.color,0,{type:'v3',value:new THREE.Vector3(0.38,0.39,0.52)})}})});pageContainerWrap.hooks.on('animation:in:start',()=>{gsap.to(uniforms.color,0,{type:'v3',value:new THREE.Vector3(0.38,0.39,0.52)});gsap.to(".backgroundContainer .backgrounds",0,{opacity:0});$(".loadCanvasWrapper").removeClass("loaded");gsap.to(".loadCanvasWrapper",.9,{opacity:0,ease:"power1.out"});gsap.to(uniforms.time,.9,{value:0.0,ease:"power1.out",onComplete:function(){scroller.start();$("html, body").removeClass("overflow overflowMenu");loadCanvasFrame=!1}})})}
;