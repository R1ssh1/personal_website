var anchor="";var MVLogoTimeline;var disableMenu=!1;var drawTextMenu;$(document).ready(function(){MVLogoIconAnimate();pageContainerWrap.hooks.before('animation:in:start',()=>{$("header .menu-item").removeClass("active");if($(".blocks").attr("data-id")){$(".page-"+$(".blocks").attr("data-id")).addClass("active")}});$(document).off("click.menuLink","header .menuContainer li a").on("click.menuLink","header .menuContainer li a",function(e){$("header .menuContainer li").removeClass("active");$(this).closest("li").addClass("active")});$(document).on("initPage",function(){disableMenu=!1;if($(".blocks").attr("data-id")){$("header .page-"+$(".blocks").attr("data-id")).addClass("active")}
if($(".homeHeaderBlock").length>0){var delay=2300}else{var delay=600}
setTimeout(function(){$(".menuIcon").addClass("active");checkHeaderScroll();gsap.to("header .headerBar",.6,{y:0,opacity:1,ease:"power2.out"})},delay)});pageContainerWrap.hooks.on('animation:out:end',()=>{disabledHeaderScroll=!0;$("header").removeClass("scrolled")});$(document).on("initScroll",function(){scroller.on("scroll",function(){checkHeaderScroll()})});$(document).off("click.hamburger",".menuIcon").on("click.hamburger",".menuIcon",function(e){if(!disableMenu){if($("header").hasClass("open")){disableMenu=!0;$("header").removeClass("open");$(document).trigger("animateLoaderOut");setTimeout(function(){$("html, body").removeClass("overflowMenu");scroller.start();drawTextMenu.clear();disableMenu=!1},600)}else{drawTextMenu=gsap.timeline({repeat:0});drawTextMenu.to(".hamburgerMenu .drawTextContainer .draw",0,{drawSVG:"0% 0%"});drawTextMenu.to(".hamburgerMenu .drawTextContainer .draw:nth-child(1)",.45,{drawSVG:"100% 0%",ease:"power1.in"});drawTextMenu.to(".hamburgerMenu .drawTextContainer .draw:nth-child(2)",.7,{drawSVG:"-100% 0%",delay:0,ease:"power1.in"});drawTextMenu.to(".hamburgerMenu .drawTextContainer .draw:nth-child(3)",.45,{drawSVG:"100% 0%",delay:0,ease:"power1.in"});drawTextMenu.to(".hamburgerMenu .drawTextContainer .draw:nth-child(4)",.9,{drawSVG:"100% 0%",delay:0,ease:"power1.in"});disableMenu=!0;$("header").addClass("open");$("html, body").addClass("overflowMenu");scroller.stop();$(document).trigger("animateLoaderIn");setTimeout(function(){disableMenu=!1},600)}}});$(document).off("click.hamburgerMenua",".hamburgerMenu .mainMenu a").on("click.hamburgerMenua",".hamburgerMenu .mainMenu a",function(e){if($("header").hasClass("open")){$("header").removeClass("open")}})});function checkHeaderScroll(){if(currentScrollY>$(".headerBar").height()/3){$("header").addClass("scrolled")}else{$("header").removeClass("scrolled")}
if(currentScrollY<$(".headerBar").height()){gsap.to(".headerBar .left",0,{y:-currentScrollY});gsap.to(".headerBar .right",0,{y:-currentScrollY})}else{gsap.to(".headerBar .left",0,{y:-$(".headerBar").height()});gsap.to(".headerBar .right",0,{y:-$(".headerBar").height()})}
if(currentScrollY<50){gsap.to(".headerBar .menuContainer .background",0,{backdropFilter:"blur("+(currentScrollY/2)+"px)"})}else{gsap.to(".headerBar .menuContainer .background",0,{backdropFilter:"blur(25px)"})}}
function MVLogoIconAnimate(){if(MVLogoTimeline){MVLogoTimeline.kill()}
MVLogoTimeline=gsap.timeline({repeat:-1,duration:1.2,ease:"linear",onRepeat:function(){gsap.to(".MVLogo-1",0,{opacity:1,delay:.15});gsap.to(".MVLogo-1",0,{opacity:0,delay:.3});gsap.to(".MVLogo-2",0,{opacity:1,delay:.3});gsap.to(".MVLogo-2",0,{opacity:1,delay:.45});gsap.to(".MVLogo-2",0,{opacity:0,delay:.6});gsap.to(".MVLogo-3",0,{opacity:1,delay:.6});gsap.to(".MVLogo-3",0,{opacity:1,delay:.75});gsap.to(".MVLogo-3",0,{opacity:0,delay:.9});gsap.to(".MVLogo-4",0,{opacity:1,delay:.9});gsap.to(".MVLogo-4",0,{opacity:1,delay:1.05});gsap.to(".MVLogo-4",0,{opacity:0,delay:1.2});gsap.to(".MVLogo-1",0,{opacity:1,delay:1.2})}})
MVLogoTimeline.play()}
;