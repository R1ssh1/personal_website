$(document).ready(function(){$(document).on("initPage",function(){initWords()})});function initWords(){$("[data-words]").addClass("active");$("[data-words]").addClass("active");new SplitText($("[data-words]"),{type:"lines, words",wordsClass:"word",linesClass:"line",tag:"span"});$("[data-scroll-words]").each(function(i,el){if($(el).data("scroll-direct")==!0){ScrollTrigger.create({trigger:$(el),start:"0% 100%",end:"0% 100%",onEnter(){animWords(el)}})}else{ScrollTrigger.create({trigger:$(el),start:"0% 90%",end:"0 90%",onEnter(){animWords(el)}})}})}
function animWords(el){if($(el).data("words-fast")==!0){var delay=0.1}else{var delay=0.3}
$(el).find(".line").each(function(i,el){gsap.to($(el).find(".word"),.6,{y:0.00,rotate:0,opacity:1,delay:(delay*i),ease:"power2.out",onComplete:function(){$(el).addClass("transformNone")}})})}
;