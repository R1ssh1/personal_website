$(document).ready(function(){$(document).on("initPage",function(){if($(".workFeaturedBlock").length>0){ScrollTrigger.create({trigger:$(".workFeaturedBlock .drawTextContainer"),start:"0% 90%",end:"0% 90%",once:!0,onEnter(self){gsap.to(".workFeaturedBlock .drawTextContainer .draw",0,{drawSVG:"0%"});gsap.to(".workFeaturedBlock .drawTextContainer",0,{y:0,opacity:1,ease:"power2.out",delay:0});gsap.to(".workFeaturedBlock .drawTextContainer .draw:nth-child(1)",.45,{drawSVG:"100%",delay:0.1,ease:"power1.in"});gsap.to(".workFeaturedBlock .drawTextContainer .draw:nth-child(2)",.7,{drawSVG:"-100%",delay:0.6,ease:"power1.in"})}})}})})
