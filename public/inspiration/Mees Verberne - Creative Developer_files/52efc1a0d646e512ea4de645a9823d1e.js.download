var errorCanvas;var errorRenderer;var errorScene;var errorCamera;var errorFirstLoad=!1;var errorFirstMove=!0;var errorSetStrength=!1;var errorDelayMove=!0;$(document).ready(function(){$(document).on("initPage",function(){if($(".errorBlock").length>0){var cloned=$(".errorBlock .copyErrorContent").clone();$(".errorCanvasContainer").append(cloned);initMarquees();setTimeout(function(){$(".copyErrorContent").addClass("active");gsap.to(".errorBlock .copyErrorContent .buttonWrapper .button",.6,{y:0,opacity:1,ease:"power2.out",delay:.1});gsap.to(".errorCanvasContainer .copyErrorContent .errorTitle .row:first-child .line",.6,{y:0,ease:"power2.out"});gsap.to(".errorCanvasContainer .copyErrorContent .errorTitle .row:nth-child(2) .line",.6,{y:0,ease:"power2.out",delay:.05});gsap.to(".errorBlock .copyErrorContent .errorTitle .row:nth-child(3) .line",.6,{y:0,ease:"power2.out",delay:.1});gsap.to(".errorCanvasContainer .copyErrorContent .errorTitle .row:nth-child(4) .line",.6,{y:0,ease:"power2.out",delay:.15});gsap.to(".errorCanvasContainer .copyErrorContent .errorTitle .row:nth-child(5) .line",.6,{y:0,ease:"power2.out",delay:.2});initErrorCanvas()},600)}});pageContainerWrap.hooks.before('content:replace',()=>{var errorCanvas="";var errorRenderer="";var errorScene="";var errorCamera="";$(".errorCanvasContainer .copyErrorContent, #errorCanvas").remove()})});function initErrorCanvas(){if(!$("html").hasClass("touch")){$(document).off("mousemove.errorCanvas").on("mousemove.errorCanvas",".errorBlock",function(e){if($(".errorBlock").length>0){if(!errorFirstMove){var duration=0}else{var duration=.3}
