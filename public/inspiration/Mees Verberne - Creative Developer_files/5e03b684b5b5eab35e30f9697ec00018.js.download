$(document).ready(function(){if($(".homeHeaderBlock").length>0){var delay=2900}else{var delay=900}
setTimeout(function(){$(".backgroundContainer").addClass("inview");initBackgroundObject()},delay)});function initBackgroundObject(){var canvas=document.getElementById('backgroundCanvas');var renderer=new THREE.WebGLRenderer({alpha:!0,canvas:canvas,precision:"mediump"});renderer.setSize(window.innerWidth,window.innerHeight);var scene=new THREE.Scene();var camera=new THREE.PerspectiveCamera(75,1,0.1,1000);camera.position.z=1;var uniforms={time:{type:'f',value:0.0},resolution:{type:'v2',value:new THREE.Vector2(canvas.width,canvas.height)},mousePos:{type:'v2',value:new THREE.Vector2(0.5,0.5)},scaleX:{type:'f',value:20.0},scaleY:{type:'f',value:40.0}};var vertexShader=`
        void main() {
            gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);
        }
    `;const fragmentShader=`
        precision mediump float;

        uniform float time;
        uniform vec2 resolution;
        uniform vec2 mousePos;
        uniform float scaleX; // Dynamische schaal voor de X-as
        uniform float scaleY; // Vaste schaal voor de Y-as

        float grid(vec2 st, vec2 scale) {
            vec2 grid = fract(st * scale); // Gebruik aparte schalen voor X en Y
            float size = 0.0; // Zorg voor een minimale waarde om tussenruimte te vermijden
            return step(size, grid.x) * step(size, grid.y);
        }

        float random(vec2 st) {
            return fract(sin(dot(st.xy, vec2(12.9898, 78.233))) * 43758.5453123);
        }

        bool isUnderMouse(vec2 st, vec2 mouseCoord, vec2 scale) {
            vec2 gridCoord = floor(st * scale);
            vec2 size = vec2(1.0) / scale;
            return abs(gridCoord.x - floor(mouseCoord.x * scale.x)) < size.x &&
                   abs(gridCoord.y - floor(mouseCoord.y * scale.y)) < size.y;
        }

        void main() {
            vec2 st = gl_FragCoord.xy / resolution.xy;

            vec2 scale = vec2(scaleX, scaleY);
            float g = grid(st, scale);

            vec2 gridCoord = floor(st * scale);
            float offset = random(gridCoord);

            float fadeTime = time * 0.2; // Langzamere tijdsverandering voor fade
            float fade = 0.5 * (1.1 + sin(fadeTime + offset * 6.28318)); // Sinus voor vloeiende fade

            bool underMouse = isUnderMouse(st, mousePos, scale);

            vec3 color = underMouse ? vec3(0.0, 0.0, 0.0) : vec3(0.9); // Rood voor muis, wit anders
            float finalFade = underMouse ? 0.9 : fade; // Muis: volledige opacity, anders fade-effect

            gl_FragColor = vec4(color, finalFade * g);
        }
    `;var material=new THREE.ShaderMaterial({uniforms:uniforms,vertexShader:vertexShader,fragmentShader:fragmentShader});var planeGeometry=new THREE.PlaneGeometry(10,10,100,100);var plane=new THREE.Mesh(planeGeometry,material);scene.add(plane);function animate(){requestAnimationFrame(animate);if($(window).width()<=580){var value=0.4}else{var value=0.4}
uniforms.time.value+=value;renderer.render(scene,camera)}
animate();function calculateScaleX(){if($(window).width()<=580){var baseGridCountX=15}else{var baseGridCountX=45}
return canvas.width/baseGridCountX}
function calculateScaleY(){if($(window).width()<=580){var fixedRowCount=40}else{var fixedRowCount=20}
return fixedRowCount}
function resizeCanvas(){canvas.width=window.innerWidth;canvas.height=window.innerHeight;renderer.setSize(canvas.width,canvas.height);uniforms.resolution.value.set(canvas.width,canvas.height);camera.aspect=canvas.width/canvas.height;camera.updateProjectionMatrix();uniforms.scaleX.value=calculateScaleX();uniforms.scaleY.value=calculateScaleY()}
resizeCanvas();window.addEventListener('resize',resizeCanvas,!1);$(document).off("mousemove.canvas",canvas).on("mousemove.canvas",canvas,function(e){var rect=canvas.getBoundingClientRect();var mouseX=(e.clientX-rect.left)/rect.width;var mouseY=1.0-(e.clientY-rect.top)/rect.height;material.uniforms.mousePos.value.set(mouseX,mouseY)})}
;