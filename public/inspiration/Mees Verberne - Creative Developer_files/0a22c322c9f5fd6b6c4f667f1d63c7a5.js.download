$(document).ready(function(){$(document).on("initPage",function(){if($(".aboutHeaderBlock").length>0){$(".aboutHeaderBlock").addClass("active");setTimeout(function(){gsap.to(".aboutHeaderBlock .hugeTitle .row:first-child .line",.6,{y:0,ease:"power2.out"});gsap.to(".aboutHeaderBlock .hugeTitle .row:last-child .line",.6,{y:0,ease:"power2.out",delay:.1});gsap.to(".aboutHeaderBlock .hugeTitle .row:last-child .left .innerText",.6,{x:-$(".aboutHeaderBlock .hugeTitle .row:last-child .left").position().left,ease:"power2.out",delay:.6});gsap.to(".aboutHeaderBlock .hugeTitle .row:last-child .right .innerText",.6,{x:$(".aboutHeaderBlock .hugeTitle .row:last-child .left").position().left,ease:"power2.out",delay:.6});gsap.to(".aboutHeaderBlock .animatedText .text",.6,{y:0,opacity:1,ease:"power2.out",delay:.65});gsap.to(".aboutHeaderBlock .tags",.6,{y:0,opacity:1,ease:"power2.out",delay:.9})},100)}})})
;