var disableInview=!1;var currentWidth=0;$(document).ready(function(){currentWidth=$(window).width();$(window).on("resize",function(e){if(currentWidth!=$(window).width()){addInviewClasses();currentWidth=$(window).width()}});$(document).on("initPage",function(){addInviewClasses();disableInview=!1})});function addInviewClasses(){$("[data-scroll-inview]").each(function(i,el){if($(el).data("scroll-direct")==!0){ScrollTrigger.create({trigger:$(el),start:"0% 100%",end:"0 100%",onEnter(){$(el).addClass("inview")}})}else{ScrollTrigger.create({trigger:$(el),start:"0% 90%",end:"0% 90%",onEnter(self){$(el).addClass("inview")}})}})}
;