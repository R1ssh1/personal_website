$(document).ready(function(){$(document).on("initPage",function(){initLetters()});pageContainerWrap.hooks.on('animation:in:start',()=>{$(".hugeTitle").each(function(i,el){var currentHeight=$(el).find(".line").height();$(el).find(".row").height(currentHeight*1)})});$(window).on("resize",function(){$(".hugeTitle").each(function(i,el){var currentHeight=$(el).find(".line").height();$(el).find(".row").height(currentHeight*1)})})});function initLetters(){$("[data-letters]").addClass("active");new SplitText($("[data-letters]"),{type:"lines, chars",charsClass:"letter",linesClass:"line",tag:"span"});$(".hugeTitle").each(function(i,el){var scaleFactor=1;var fontSize=16.25;$(el).css("font-size",fontSize+"vw");$(el).find(".row").each(function(i,el){var rowWidth=$(el).width();var lineWidth=$(el).find(".line").width();var fontSize=16.25;var scale=rowWidth/lineWidth;if(scale<scaleFactor){scaleFactor=scale}});if(scaleFactor<1){fontSize=fontSize*scaleFactor}
$(el).css("font-size",fontSize+"vw");var currentHeight=$(el).find(".line").height();$(el).find(".row").height(currentHeight*1);ScrollTrigger.update()})}
;