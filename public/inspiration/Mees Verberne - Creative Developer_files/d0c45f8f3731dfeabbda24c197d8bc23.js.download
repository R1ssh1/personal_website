$(document).ready(function(){$(document).on("initVideoCanvas",function(){playVideoCanvasOnScroll()})});function playVideoCanvasOnScroll(){$(".setVideoOnScroll").each(function(i,el){var src=$(this).attr("data-video-src");var poster=$(this).attr("data-video-poster");if($(window).width()<=580){src=$(this).attr("data-video-mobile-src")}
var html='<video class="video" muted playsinline loop poster="'+poster+'"><source src="'+src+'" type="video/mp4"></video>';ScrollTrigger.create({trigger:$(el),start:"0% 150%",end:"150% 0%",onEnter(){if($(el).find("video").length==0){$(el).html(html);var delay=200;if($(window).width()<=580){delay=600}
setTimeout(function(){$(el).addClass("active")},delay)}
var isPlaying=$(el).find("video")[0].currentTime>0&&!$(el).find("video")[0].paused&&!$(el).find("video")[0].ended&&$(el).find("video")[0].readyState>$(el).find("video")[0].HAVE_CURRENT_DATA;if(!$(el).find("video").data("play")&&!isPlaying){$(el).find("video")[0].play();$(el).find("video").data("play",!0)}},onEnterBack(){var isPlaying=$(el).find("video")[0].currentTime>0&&!$(el).find("video")[0].paused&&!$(el).find("video")[0].ended&&$(el).find("video")[0].readyState>$(el).find("video")[0].HAVE_CURRENT_DATA;if(!$(el).find("video").data("play")&&!isPlaying){$(el).find("video")[0].play();$(el).find("video").data("play",!0)}},onLeave(){var isPlaying=$(el).find("video")[0].currentTime>0&&!$(el).find("video")[0].paused&&!$(el).find("video")[0].ended&&$(el).find("video")[0].readyState>$(el).find("video")[0].HAVE_CURRENT_DATA;if($(el).find("video").data("play")&&isPlaying){$(el).find("video")[0].pause();$(el).find("video").data("play",!1)}},onLeaveBack(){var isPlaying=$(el).find("video")[0].currentTime>0&&!$(el).find("video")[0].paused&&!$(el).find("video")[0].ended&&$(el).find("video")[0].readyState>$(el).find("video")[0].HAVE_CURRENT_DATA;if($(el).find("video").data("play")&&isPlaying){$(el).find("video")[0].pause();$(el).find("video").data("play",!1)}}})});$(".playVideoCanvasOnScroll").each(function(i,el){ScrollTrigger.create({trigger:$(el),start:"0% 100%",end:"100% 0%",onEnter(){var isPlaying=$(el)[0].currentTime>0&&!$(el)[0].paused&&!$(el)[0].ended&&$(el)[0].readyState>$(el)[0].HAVE_CURRENT_DATA;if(!$(el).data("play")&&!isPlaying){$(el)[0].play();$(el).data("play",!0)}},onEnterBack(){var isPlaying=$(el)[0].currentTime>0&&!$(el)[0].paused&&!$(el)[0].ended&&$(el)[0].readyState>$(el)[0].HAVE_CURRENT_DATA;if(!$(el).data("play")&&!isPlaying){$(el)[0].play();$(el).data("play",!0)}},onLeave(){var isPlaying=$(el)[0].currentTime>0&&!$(el)[0].paused&&!$(el)[0].ended&&$(el)[0].readyState>$(el)[0].HAVE_CURRENT_DATA;if($(el).data("play")&&isPlaying){$(el)[0].pause();$(el).data("play",!1)}},onLeaveBack(){var isPlaying=$(el)[0].currentTime>0&&!$(el)[0].paused&&!$(el)[0].ended&&$(el)[0].readyState>$(el)[0].HAVE_CURRENT_DATA;if($(el).data("play")&&isPlaying){$(el)[0].pause();$(el).data("play",!1)}}})})}
