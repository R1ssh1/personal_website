var homeHeaderBlockTimeout;$(document).ready(function(){$(document).on("initPage",function(){if($(".homeHeaderBlock").length>0){$(".homeHeaderBlock").addClass("active");clearTimeout(homeHeaderBlockTimeout);setTimeout(function(){gsap.to(".homeHeaderBlock .drawText .draw",0,{drawSVG:"0%"});gsap.to(".homeHeaderBlock .hugeTitle .row:first-child .line",.6,{y:0,ease:"power2.out"});gsap.to(".homeHeaderBlock .hugeTitle .row:last-child .line",.6,{y:0,ease:"power2.out",delay:.1});gsap.to(".homeHeaderBlock .tags",.6,{y:0,opacity:1,ease:"power2.out",delay:.6});if($(window).width()<=580){gsap.to(".homeHeaderBlock .barCode",.6,{y:0,opacity:1,ease:"power2.out",delay:1.8})}else{gsap.to(".homeHeaderBlock .barCode",.6,{y:0,opacity:1,ease:"power2.out",delay:1.05})}
gsap.to(".homeHeaderBlock .contentContainer .mTag",.6,{y:0,opacity:1,ease:"power2.out",delay:1.2});gsap.to(".homeHeaderBlock .contentContainer .drawText",0,{y:0,opacity:1,ease:"power2.out",delay:1.35});gsap.to(".homeHeaderBlock .contentContainer .text",.6,{y:0,opacity:1,ease:"power2.out",delay:1.5});gsap.to(".homeHeaderBlock .drawText .draw:nth-child(1)",1,{drawSVG:"100%",delay:2.1,ease:"power1.in"});gsap.to(".homeHeaderBlock .drawText .draw:nth-child(2)",.3,{drawSVG:"100%",delay:3.1,ease:"power1.in"});gsap.to(".homeHeaderBlock .drawText .draw:nth-child(3)",.45,{drawSVG:"-100%",delay:3.4,ease:"power1.in"});gsap.to(".homeHeaderBlock .drawText .draw:nth-child(4)",0,{drawSVG:"100%",delay:3.85,ease:"power1.in"});gsap.to(".homeHeaderBlock .drawText .draw:nth-child(5)",.3,{drawSVG:"100%",delay:4.05,ease:"power1.in"});gsap.to(".homeHeaderBlock .drawText .draw:nth-child(6)",.3,{drawSVG:"100%",delay:4.35,ease:"power1.in"});gsap.to(".homeHeaderBlock .drawText .draw:nth-child(7)",.6,{drawSVG:"-100%",delay:4.65,ease:"power1.in"});gsap.to(".homeHeaderBlock .drawText .draw:nth-child(8)",.45,{drawSVG:"100%",delay:5.25,ease:"power1.in"});gsap.to(".homeHeaderBlock .drawText .draw:nth-child(9)",.45,{drawSVG:"100%",delay:5.7,ease:"power1.in"});gsap.to(".homeHeaderBlock .innerLocation",.6,{y:0,opacity:1,ease:"power2.out",delay:1.8});gsap.to(".homeHeaderBlock .extraInfo",.6,{y:0,opacity:1,ease:"power2.out",delay:1.95})},300);homeHeaderBlockTimeout=setTimeout(function(){gsap.to(".homeHeaderBlock .canvasContainer",.9,{opacity:1,ease:"power2.out"});$(document).trigger("loadCanvasHeaderBlock")},1600)}})})
;