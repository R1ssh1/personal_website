$(".fixedCanvasWrapper").append("<canvas id='errorCanvas'></canvas>");errorCanvas=document.getElementById('errorCanvas');var vertexShader=`
            varying vec2 vUv;

            void main() {
                vUv = uv;
                gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);
            }
        `;var fragmentShader=`
            uniform vec2 u_mouse;
            uniform vec2 u_resolution;
            uniform float u_gridSize;
            uniform float u_strength;
            uniform float u_time;
            uniform sampler2D u_texture;
            uniform float u_randomValue;
            varying vec2 vUv;

            float random(vec2 st) {
                return fract(sin(dot(st.xy, vec2(12.9898, 78.233))) * u_randomValue);
            }

            void main() {
                // Bepaal de grid grootte en cellen
                vec2 gridSize = vec2(u_gridSize, u_gridSize);
                vec2 gridCoord = floor(vUv * gridSize) / gridSize;
                vec2 gridCenter = gridCoord + 0.5 / gridSize;

                // Bereken de afstand van de muis tot het centrum van het grid item
                vec2 mouseDist = (u_mouse - gridCenter) * gridSize;

                // Bepaal de vervorming afhankelijk van de afstand van de muis
                float distToMouse = length(mouseDist);
                float effectStrength = 1.0 - smoothstep(0.0, u_gridSize * 0.4, distToMouse);

                // Bereken de offset in de richting van de muisbeweging
                vec2 offset = mouseDist * effectStrength * u_strength;

                // Bereken de verstoorde UV-coördinaten
                vec2 distortedUv = vUv;
                if (abs(mouseDist.x) > abs(mouseDist.y)) {
                    distortedUv.x += offset.x / gridSize.x;
                } else {
                    distortedUv.y += offset.y / gridSize.y;
                }

                // Willekeurige vertraging per vierkantje gebaseerd op gridCoord
                float randomness = random(gridCoord);  // Genereer een willekeurige waarde per vierkantje
                float randomDelay = randomness * 1.0;  // Maximaal 2 seconden vertraging

                // Voeg tijd-gebaseerde fading effect toe om het grid langzaam te laten verschijnen
                float fadeInEffect = smoothstep(0.0, 1.0, u_time - randomDelay);

                // Zorg ervoor dat UV-coördinaten binnen [0, 1] blijven
                distortedUv = clamp(distortedUv, vec2(0.0), vec2(1.0));

                // Haal de kleur op van de textuur met de verstoorde UV-coördinaten
                vec4 color = texture2D(u_texture, distortedUv);

                // Pas de kleur aan op basis van de fade-in effect
                color.rgb = mix(vec3(0.0), color.rgb, fadeInEffect);  // Zachtere kleurtransitie

                // Stel de fragmentkleur in, waarbij de alfa-kanaal ook beïnvloed wordt door het fade-in effect
                gl_FragColor = vec4(color.rgb, fadeInEffect);  // Stel de alfa-kanaal in voor transparantie
            }
        `;errorScene=new THREE.Scene();errorScene.userData.element=canvas;errorCamera=new THREE.PerspectiveCamera(50,1,1,10);errorCamera.position.z=2.1;errorScene.userData.camera=errorCamera;const geometry=new THREE.PlaneGeometry(2,2,50,50);var texture=new THREE.TextureLoader().load($(".errorCanvasWrapper .innerCanvasFixed").attr("data-image"));texture.generateMipmaps=!0;texture.minFilter=THREE.LinearMipmapLinearFilter;var gridSize=25.0;const uniforms={u_mouse:{value:new THREE.Vector2(0.5,0.5)},u_resolution:{value:new THREE.Vector2($(".errorCanvasWrapper .fixedCanvasWrapper").width(),$(".errorBlock .fixedCanvasWrapper").height())},u_gridSize:{value:gridSize},u_strength:{value:0},u_time:{value:0},u_texture:{value:texture},u_randomValue:{value:43758.5453123+Math.random()*(103758.5453123-43758.5453123)}};var material=new THREE.ShaderMaterial({vertexShader:vertexShader,fragmentShader:fragmentShader,uniforms:uniforms});var mesh=new THREE.Mesh(geometry,material);mesh.scale.set(1,1);errorScene.add(mesh);errorRenderer=new THREE.WebGLRenderer({antialias:!0,alpha:!0,canvas:errorCanvas,precision:"mediump"});errorRenderer.setPixelRatio(window.devicePixelRatio);gsap.to(errorScene.children[0].material.uniforms.u_time,2,{value:3,overwrite:!0,delay:.15,ease:"power1.out"});updateErrorSize();animateErrorCanvas()}
function updateErrorSize(){var height=$(".errorCanvasWrapper .fixedCanvasWrapper").height();var width=$(".errorCanvasWrapper .fixedCanvasWrapper").width();errorRenderer.setSize(width,height,!1)}
function animateErrorCanvas(){if(errorScene&&$(".errorBlock").length>0){renderErrorCanvas();requestAnimationFrame(animateErrorCanvas)}}
function renderErrorCanvas(){errorRenderer.render(errorScene,errorCamera)}
;