# Environment Variables Example
# Copy this file to .env.local for local development
# Update values with your actual credentials

# =============================================================================
# ADMIN AUTHENTICATION
# =============================================================================
# These credentials are used to create the initial admin user
# Run `npm run setup-admin` to create the admin account

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_in_production

# =============================================================================
# DATABASE
# =============================================================================
# Leave empty for development (uses SQLite at data/portfolio.db)
# For production, use PostgreSQL/Neon connection string:
# DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

DATABASE_URL=

# =============================================================================
# VERCEL BLOB STORAGE (Optional)
# =============================================================================
# Required for file uploads in admin dashboard
# Get credentials from: https://vercel.com/dashboard/stores

BLOB_READ_WRITE_TOKEN=

# =============================================================================
# DEPLOYMENT
# =============================================================================
# Vercel automatically sets these in production
# No need to set locally

# VERCEL=1
# VERCEL_ENV=production
# VERCEL_URL=your-site.vercel.app

# =============================================================================
# SECURITY (Future Implementation)
# =============================================================================
# JWT/Session secret for secure session management
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# SESSION_SECRET=

# =============================================================================
# EXTERNAL SERVICES (Optional)
# =============================================================================
# Add API keys for external services here

# GOOGLE_ANALYTICS_ID=
# SENTRY_DSN=
# RESEND_API_KEY=

# =============================================================================
# DEVELOPMENT
# =============================================================================
NODE_ENV=development