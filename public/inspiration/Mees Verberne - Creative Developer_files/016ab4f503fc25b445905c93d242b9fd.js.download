$(document).ready(function(){$(document).on("initPage",function(){if($(".contactBlock").length>0){$(".contactBlock").addClass("active inview");setTimeout(function(){gsap.to(".contactBlock .hugeTitle .row .line",.6,{y:0,ease:"power2.out"});gsap.to(".contactBlock .tags",.6,{y:0,opacity:1,ease:"power2.out",delay:.6});gsap.to(".contactBlock .col:first-child .text",.6,{y:0,opacity:1,ease:"power2.out",delay:0.9});gsap.to(".contactBlock .col:nth-child(2)",.6,{y:0,opacity:1,ease:"power2.out",delay:1.05});gsap.to(".contactBlock .col:nth-child(3)",.6,{y:0,opacity:1,ease:"power2.out",delay:1.2});gsap.to(".contactBlock .col:nth-child(4) .location",.6,{y:0,opacity:1,ease:"power2.out",delay:1.35})},100);ScrollTrigger.create({trigger:$(".contactBlock .drawTextContainer"),start:"0% 90%",end:"0% 90%",once:!0,onEnter(self){gsap.to(".contactBlock .drawTextContainer .draw",0,{drawSVG:"0%"});gsap.to(".contactBlock .drawTextContainer",0,{y:0,opacity:1,ease:"power2.out",delay:0});gsap.to(".contactBlock .drawTextContainer .draw:nth-child(1)",.45,{drawSVG:"100%",delay:0.6,ease:"power1.in"});gsap.to(".contactBlock .drawTextContainer .draw:nth-child(2)",.7,{drawSVG:"-100%",delay:1.1,ease:"power1.in"})}});setTimeout(function(){initContactForm()},300)}})});function initContactForm(){$('.contactBlock form').find('input, select, textarea').each(function(i,el){if($(el).attr("aria-required")=="true"){$(el).attr("required",!0)}});$('.contactBlock form').submit(function(e){$('.contactBlock form').find('input, select, textarea').each(function(i,el){$(el).removeClass("invalid")});$(".contactBlock form .wpcf7-submit").addClass("disabled");e.preventDefault();var form=$(this);$.ajax({type:'POST',url:form.attr('action'),data:form.serialize(),success:function(response){if(response.startsWith("Array")){$('.contactBlock .formWrapper').addClass("submitted");setTimeout(function(){$('.contactBlock form')[0].reset()},300)}else{$(".contactBlock form .wpcf7-submit").removeClass("disabled");$('.contactBlock form').find('input, select, textarea').each(function(i,el){if(!el.checkValidity()){$(el).addClass('invalid')}else{$(el).removeClass('invalid')}});scroller.scrollTo($('.contactBlock form').offset().top-$(".headerBar").height())}}})})}
;