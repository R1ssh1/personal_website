var canvas,renderer;var scenes=[];var mouse;var currentHeightFix=0;var currentWidth;var pageCanvasTimeout;var firstLoad=!1;var firstMove=!0;var setStrength=!1;var delayMove=!0;$(document).ready(function(){$(document).off("initPage.pageCanvas").on("initPage.pageCanvas",function(){if(firstLoad){var delay=300}else{if($(".homeHeaderBlock").length>0){var delay=2900}else{var delay=600}}
firstLoad=!0;clearTimeout(pageCanvasTimeout);pageCanvasTimeout=setTimeout(function(){if($(".innerCanvas").length>0){init();animate()}},delay)});pageContainerWrap.hooks.on('animation:out:end',()=>{clearTimeout(pageCanvasTimeout);$("#pageCanvas").remove();canvas="";renderer="";scenes=[]});window.addEventListener('resize',updateSize);if(!$("html").hasClass("touch")){$(document).off("mousemove.innerCanvas").on("mousemove.innerCanvas",".canvasContainer .innerCanvas",function(e){if(scenes.length>0){if(!firstMove){var duration=0}else{var duration=.3}
if(delayMove){delay=0.2;delayMove=!1}else{delay=0}
firstMove=!0;var mouseX=(e.pageX-$(this).offset().left)/$(this).width();var mouseY=1.0-(e.pageY-$(this).offset().top)/$(this).height();var index=$(this).data("index");if(!setStrength){setStrength=!0;gsap.to(scenes[index].children[0].material.uniforms.u_strength,.6,{value:.8,overwrite:!0,delay:delay})}
gsap.to(scenes[index].children[0].material.uniforms.u_mouse.value,duration,{x:mouseX,y:mouseY,overwrite:!0,onComplete(){setStrength=!1;gsap.to(scenes[index].children[0].material.uniforms.u_strength,.6,{value:0,delay:0.3})}})}});$(document).off("mouseenter.innerCanvas").on("mouseenter.innerCanvas",".canvasContainer .innerCanvas",function(e){if(scenes.length>0){setStrength=!1}});$(document).off("mouseleave.innerCanvas").on("mouseleave.innerCanvas",".canvasContainer .innerCanvas",function(e){if(scenes.length>0){firstMove=!1;setStrength=!1;var index=$(this).data("index");gsap.to(scenes[index].children[0].material.uniforms.u_strength,.6,{value:0,overwrite:!0})}})}});function init(){$(".pageCanvasWrapper").append("<canvas id='pageCanvas'></canvas>");canvas=document.getElementById('pageCanvas');$("#pageCanvas").height(window.innerHeight+300);currentHeightFix=window.innerHeight+300;currentWidth=window.innerWidth;var vertexShader=`
            varying vec2 vUv;

            void main() {
                vUv = uv;
                gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);
            }
        `;var fragmentShader=`
            uniform vec2 u_mouse;
            uniform vec2 u_resolution;
            uniform float u_gridSize;
            uniform float u_strength;
            uniform float u_time;
            uniform sampler2D u_texture;
            uniform float u_randomValue;
            varying vec2 vUv;

            float random(vec2 st) {
                return fract(sin(dot(st.xy, vec2(12.9898, 78.233))) * u_randomValue);
            }

            void main() {
                // Bepaal de grid grootte en cellen
                vec2 gridSize = vec2(u_gridSize, u_gridSize);
                vec2 gridCoord = floor(vUv * gridSize) / gridSize;
                vec2 gridCenter = gridCoord + 0.5 / gridSize;

                // Bereken de afstand van de muis tot het centrum van het grid item
                vec2 mouseDist = (u_mouse - gridCenter) * gridSize;

                // Bepaal de vervorming afhankelijk van de afstand van de muis
                float distToMouse = length(mouseDist);
                float effectStrength = 1.0 - smoothstep(0.0, u_gridSize * 0.4, distToMouse);

                // Bereken de offset in de richting van de muisbeweging
                vec2 offset = mouseDist * effectStrength * u_strength;

                // Bereken de verstoorde UV-coördinaten
                vec2 distortedUv = vUv;
                if (abs(mouseDist.x) > abs(mouseDist.y)) {
                    distortedUv.x += offset.x / gridSize.x;
                } else {
                    distortedUv.y += offset.y / gridSize.y;
                }

                // Willekeurige vertraging per vierkantje gebaseerd op gridCoord
                float randomness = random(gridCoord);  // Genereer een willekeurige waarde per vierkantje
                float randomDelay = randomness * 1.0;  // Maximaal 2 seconden vertraging

                // Voeg tijd-gebaseerde fading effect toe om het grid langzaam te laten verschijnen
                float fadeInEffect = smoothstep(0.0, 1.0, u_time - randomDelay);

                // Zorg ervoor dat UV-coördinaten binnen [0, 1] blijven
                distortedUv = clamp(distortedUv, vec2(0.0), vec2(1.0));

                // Haal de kleur op van de textuur met de verstoorde UV-coördinaten
                vec4 color = texture2D(u_texture, distortedUv);

                // Pas de kleur aan op basis van de fade-in effect
                color.rgb = mix(vec3(0.0), color.rgb, fadeInEffect);  // Zachtere kleurtransitie

                // Stel de fragmentkleur in, waarbij de alfa-kanaal ook beïnvloed wordt door het fade-in effect
                gl_FragColor = vec4(color.rgb, fadeInEffect);  // Stel de alfa-kanaal in voor transparantie
            }
        `;$(".canvasContainer .innerCanvas").each(function(i,el){$(el).data("index",i);const scene=new THREE.Scene();scene.userData.element=el;const camera=new THREE.PerspectiveCamera(50,1,1,10);camera.position.z=2.1;scene.userData.camera=camera;const geometry=new THREE.PlaneGeometry(2,2,50,50);if($(el).attr("data-biggerGrid")=="true"){var gridSize=20.0}else{var gridSize=15.0}
const uniforms={u_mouse:{value:new THREE.Vector2(0.5,0.5)},u_resolution:{value:new THREE.Vector2(window.innerWidth,window.innerHeight)},u_gridSize:{value:gridSize},u_strength:{value:0},u_time:{value:0},u_texture:{value:""},u_randomValue:{value:43758.5453123+Math.random()*(103758.5453123-43758.5453123)}};var material=new THREE.ShaderMaterial({vertexShader:vertexShader,fragmentShader:fragmentShader,uniforms:uniforms});var mesh=new THREE.Mesh(geometry,material);mesh.scale.set(1,1);scene.add(mesh);scenes.push(scene)});$(document).trigger("initVideoCanvas");renderer=new THREE.WebGLRenderer({antialias:!0,alpha:!0,canvas:canvas,precision:"mediump"});renderer.setPixelRatio(window.devicePixelRatio);updateSize();if(scenes.length>0){$(".canvasContainer .innerCanvas:not(.loadCanvasHeaderBlock)").each(function(i,el){if(!$(el).hasClass("hide")){$(el).addClass("hide");ScrollTrigger.create({trigger:$(el),start:"0% 200%",end:"0 200%",onEnter(){if(!$(el).hasClass("loaded")){$(el).addClass("loaded");var index=$(el).data("index");if($(el).hasClass("video")){if($(window).width()>1080){var html='<video class="playVideoCanvasOnScroll" muted playsinline autoplay loop preload="auto"><source src="'+$(el).attr("data-video")+'"></video>';$(el).html(html);var texture=new THREE.VideoTexture($(el).find("video")[0])}else{var texture=new THREE.TextureLoader().load($(el).attr("data-resp-image"))}}else{var texture=new THREE.TextureLoader().load($(el).attr("data-image"))}
texture.generateMipmaps=!0;texture.minFilter=THREE.LinearMipmapLinearFilter;gsap.to(scenes[index].children[0].material.uniforms.u_texture,0,{value:texture})}}});ScrollTrigger.create({trigger:$(el),start:"0% 90%",end:"0 90%",onEnter(){var index=$(el).data("index");if($(el).data("delay")){gsap.to(scenes[index].children[0].material.uniforms.u_time,2,{value:3,overwrite:!0,delay:.15+$(el).data("delay"),ease:"power1.out"})}else{gsap.to(scenes[index].children[0].material.uniforms.u_time,2,{value:3,overwrite:!0,delay:.15,ease:"power1.out"})}}})}});if($(".canvasContainer .innerCanvas.loadCanvasHeaderBlock").length>0){var index=$(".canvasContainer .innerCanvas.loadCanvasHeaderBlock").data("index");if($(".canvasContainer .innerCanvas.loadCanvasHeaderBlock").hasClass("video")){if($(window).width()>1080){var html='<video class="playVideoCanvasOnScroll" muted playsinline loop preload="auto"><source src="'+$(".canvasContainer .innerCanvas.loadCanvasHeaderBlock").attr("data-video")+'"></video>';$(".canvasContainer .innerCanvas.loadCanvasHeaderBlock").html(html);var texture=new THREE.VideoTexture($(".canvasContainer .innerCanvas.loadCanvasHeaderBlock").find("video")[0])}else{var texture=new THREE.TextureLoader().load($(".canvasContainer .innerCanvas.loadCanvasHeaderBlock").attr("data-resp-image"))}}else{var texture=new THREE.TextureLoader().load($(".canvasContainer .innerCanvas.loadCanvasHeaderBlock").attr("data-image"))}
texture.generateMipmaps=!0;texture.minFilter=THREE.LinearMipmapLinearFilter;gsap.to(scenes[index].children[0].material.uniforms.u_texture,0,{value:texture});gsap.to(scenes[index].children[0].material.uniforms.u_time,2,{value:3,overwrite:!0,delay:.15,ease:"power1.out"});$(".canvasContainer .innerCanvas.loadCanvasHeaderBlock").addClass("hide")}}}
function updateSize(){if(scenes.length>0){if(currentWidth!=window.innerWidth){var width=window.innerWidth;var height=window.innerHeight+300;currentHeightFix=height}else{var height=currentHeightFix;var width=window.innerWidth}
if(canvas.width!==width||canvas.height!==height){renderer.setSize(width,height,!1)}}}
function animate(){if(scenes.length>0&&$(".pageCanvasWrapper").length>0){updateSize();render();requestAnimationFrame(animate)}}
function render(){if($(".pageCanvasWrapper").length>0){gsap.to(canvas,0,{y:window.scrollY});renderer.setScissorTest(!1);renderer.clear();renderer.setScissorTest(!0);scenes.forEach(function(scene){const element=scene.userData.element;const rect=element.getBoundingClientRect();const width=rect.right-rect.left;const height=rect.bottom-rect.top;const left=rect.left;const bottom=renderer.domElement.clientHeight-rect.bottom-100;renderer.setViewport(left,bottom,width,height);renderer.setScissor(left,bottom,width,height);const camera=scene.userData.camera;renderer.render(scene,camera)})}}
